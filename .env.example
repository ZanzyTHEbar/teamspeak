# ─────────────────────────────────────────────────────────────
# TeamSpeak + Caddy L4 — Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and adjust values before starting.
#
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────

# ── TeamSpeak License ────────────────────────────────────────
# You MUST set this to "accept" or the server will not start.
# Review the license at:
#   https://www.teamspeak.com/en/privacy-and-terms
TS3SERVER_LICENSE=accept

# ── Database Backend (optional) ──────────────────────────────
# By default TeamSpeak uses an embedded SQLite database.
# For larger deployments, uncomment the MariaDB section in
# docker-compose.yml and set these variables.
#
# TS3SERVER_DB_PLUGIN=ts3db_mariadb
# TS3SERVER_DB_SQLCREATEPATH=create_mariadb
# TS3SERVER_DB_HOST=db
# TS3SERVER_DB_USER=teamspeak
# TS3SERVER_DB_PASSWORD=changeme_strong_password
# TS3SERVER_DB_NAME=teamspeak
# TS3SERVER_DB_WAITUNTILREADY=30

# ── MariaDB (only needed with DB backend) ────────────────────
# MYSQL_ROOT_PASSWORD=changeme_root_password
# MYSQL_DATABASE=teamspeak
# MYSQL_USER=teamspeak
# MYSQL_PASSWORD=changeme_strong_password
